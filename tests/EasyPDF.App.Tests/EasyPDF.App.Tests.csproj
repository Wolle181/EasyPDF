<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EasyPDF.UI\EasyPDF.UI.csproj" />
    <ProjectReference Include="..\..\src\EasyPDF.App\EasyPDF.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The brand profile the build uses (branding/<Brand>/), for tests that compare with its values -->
    <AssemblyMetadata Include="Brand" Value="$(Brand)" />
  </ItemGroup>
</Project>
