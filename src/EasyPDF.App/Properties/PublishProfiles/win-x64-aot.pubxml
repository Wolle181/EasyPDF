<?xml version="1.0" encoding="utf-8"?>
<!-- Trial: Native AOT instead of ReadyToRun (docs/BUILDING.md "Native AOT"); the installers still use win-x64.pubxml -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishDir>../../artifacts/publish/win-x64-aot/</PublishDir>
  </PropertyGroup>
</Project>
