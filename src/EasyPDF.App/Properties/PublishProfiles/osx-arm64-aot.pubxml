<?xml version="1.0" encoding="utf-8"?>
<!-- Trial: Native AOT instead of ReadyToRun (docs/BUILDING.md "Native AOT"); the installers still use osx-arm64.pubxml -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishDir>../../artifacts/publish/osx-arm64-aot/</PublishDir>
  </PropertyGroup>
</Project>
