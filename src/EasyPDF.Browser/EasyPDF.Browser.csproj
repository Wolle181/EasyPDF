<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- The web version's browser program: the shared user interface (src/EasyPDF.UI) as .NET WebAssembly, drawn by Avalonia
       into a canvas. pdfium runs on the server (src/EasyPDF.Server serves this program and its API). -->
  <PropertyGroup>
    <TargetFramework>$(AppTargetFramework)-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EasyPDF.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- German and English texts and number formats: the culture data is needed -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- WebAssembly AOT (only when publishing): the code runs compiled instead of on .NET's interpreter. Measured with
         tools/web-timing: dialogs open 2-3 times faster, the program shows itself 2-3 s earlier; the download grows from
         about 8 to 12 MB (cached for 30 days, see StaticCaching) and the publish takes about 15 minutes. -->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mono's AOT compiler of .NET 11 aborts on these two (assertion in sgen-alloc.c); they mostly call native code and
         stay interpreted. The item is internal to WasmApp.Common.targets: check it when updating .NET. -->
    <_AOT_InternalForceInterpretAssemblies Include="SkiaSharp.dll;HarfBuzzSharp.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.3" />
    <!-- Skia and HarfBuzz built for the Emscripten of .NET 11 (Avalonia 12 itself brings the builds for .NET 9/10 only) -->
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.157.0" />
    <PackageReference Include="HarfBuzzSharp" Version="14.4.0.200" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.4.0.200" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyPDF.UI\EasyPDF.UI.csproj" />
    <ProjectReference Include="..\EasyPDF.Remote\EasyPDF.Remote.csproj" />
  </ItemGroup>
  <!-- The page's icon: the brand's -->
  <ItemGroup>
    <!-- Fonts for the preview of placed text (the browser has no system fonts), see TextMetrics.EmbeddedFonts -->
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(BrandDir)icons/app-128.png" Link="wwwroot/favicon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Introduction videos of the brand's web version (button in the header; the page plays them in a video element).
         In the image with the page, so they always match its surface (recorded with tools/DemoVideo -web) -->
    <Content Include="$(BrandDir)videos/web/introduction.*.mp4" Link="wwwroot/videos/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Avalonia.Browser adds the native libraries for the Emscripten of .NET 9/10 (3.1.56); the packages above add those for
       .NET 11 themselves -->
  <Target Name="DropOldEmscriptenLibraries" BeforeTargets="_BrowserWasmWriteRspForLinking;_WasmBuildNativeCore;WasmBuildApp">
    <ItemGroup>
      <NativeFileReference Remove="@(NativeFileReference)" Condition="$([System.String]::Copy('%(FullPath)').Contains('3.1.56'))" />
    </ItemGroup>
  </Target>
</Project>
