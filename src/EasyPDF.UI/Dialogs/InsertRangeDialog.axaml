<dlg:DialogView xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:EasyPDF.App.Dialogs"
        xmlns:vm="using:EasyPDF.App.ViewModels"
        xmlns:loc="using:EasyPDF.App.Localization"
        x:Class="EasyPDF.App.Dialogs.InsertRangeDialogView" x:DataType="vm:InsertRangeDialogViewModel"
        Title="{loc:Tr InsertRangeTitle}" DialogWidth="420" >
  <StackPanel Margin="20" Spacing="14">
    <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
    <StackPanel Spacing="6">
      <RadioButton GroupName="Scope" Content="{loc:Tr InsertRangeAll}" IsChecked="{Binding AllPages}" />
      <RadioButton GroupName="Scope" Content="{loc:Tr InsertRangeRange}" IsChecked="{Binding IsRange}" />
      <TextBox x:Name="RangeBox" Text="{Binding RangeText}" PlaceholderText="1-3, 5, 8-10" IsEnabled="{Binding IsRange}" Margin="28,0,0,0" />
      <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap" Margin="28,0,0,0" FontSize="12" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" IsEnabled="{Binding IsValid}" Click="OnOk" Content="{loc:Tr Ok}" />
      <Button MinWidth="80" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" Content="{loc:Tr Cancel}" />
    </StackPanel>
  </StackPanel>
</dlg:DialogView>
