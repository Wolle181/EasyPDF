<dlg:DialogView xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:EasyPDF.App.Dialogs"
        xmlns:vm="using:EasyPDF.App.ViewModels"
        xmlns:loc="using:EasyPDF.App.Localization"
        x:Class="EasyPDF.App.Dialogs.SplitDialogView" x:DataType="vm:SplitDialogViewModel"
        Title="{loc:Tr SplitTitle}" DialogWidth="480">
  <StackPanel Margin="20" Spacing="14">
    <StackPanel Spacing="6">
      <RadioButton GroupName="Mode" Content="{loc:Tr SplitEveryN}" IsChecked="{Binding EveryN}" />
      <TextBox Text="{Binding PagesPerPart}" Width="90" HorizontalAlignment="Left" Margin="28,0,0,0" IsEnabled="{Binding EveryN}" />
      <RadioButton GroupName="Mode" Content="{loc:Tr SplitAtSelected}" IsChecked="{Binding AtSelected}" IsEnabled="{Binding CanSplitAtSelected}" />
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="{loc:Tr SplitFolder}" FontWeight="SemiBold" IsVisible="{Binding NeedsFolder}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsFolder}">
        <TextBox Text="{Binding Folder}" />
        <Button Grid.Column="1" Click="OnBrowse" Content="{loc:Tr SplitBrowse}" />
      </Grid>
      <TextBlock Text="{loc:Tr SplitBaseName}" FontWeight="SemiBold" Margin="0,6,0,0" />
      <TextBox Text="{Binding BaseName}" />
    </StackPanel>
    <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap" FontSize="12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" IsEnabled="{Binding IsValid}" Click="OnOk" Content="{loc:Tr Ok}" />
      <Button MinWidth="80" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" Content="{loc:Tr Cancel}" />
    </StackPanel>
  </StackPanel>
</dlg:DialogView>
